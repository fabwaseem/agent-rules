{
  "name": "agentkit-rules",
  "version": "0.1.0",
  "description": "Install modular production-grade AI coding-agent instructions for Next.js, TypeScript, React, Node, NestJS, Prisma, Drizzle, Tailwind, and shadcn.",
  "type": "module",
  "bin": {
    "agentkit-rules": "./dist/cli.js"
  },
  "files": [
    "dist",
    "rules",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "prepublishOnly": "npm run validate && npm test && npm run build",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "validate": "node --experimental-strip-types src/validate-cli.ts",
    "examples": "node --experimental-strip-types scripts/refresh-examples.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false"
  },
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "author": "Waseem Anjum <66861984+fabwaseem@users.noreply.github.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabwaseem/agent-rules.git"
  },
  "homepage": "https://github.com/fabwaseem/agent-rules#readme",
  "bugs": {
    "url": "https://github.com/fabwaseem/agent-rules/issues"
  },
  "keywords": [
    "agents.md",
    "cursor",
    "claude-code",
    "github-copilot",
    "windsurf",
    "nextjs",
    "nestjs",
    "prisma",
    "drizzle",
    "tailwind",
    "shadcn",
    "coding-agent"
  ],
  "devDependencies": {
    "@types/node": "^22.15.21",
    "typescript": "^5.9.3"
  }
}
